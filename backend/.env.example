# Environment Variables for Gulabi Baker Backend
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gulabi_baker
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Secrets (use long, random strings — keep these different from each other)
JWT_CUSTOMER_SECRET=change_me_customer_secret_min_32_chars
JWT_ADMIN_SECRET=change_me_admin_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Admin Seed (used by `npm run seed`)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gulabibaker.com
ADMIN_PASSWORD=change_me_admin_password
